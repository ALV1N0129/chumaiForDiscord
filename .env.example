# 필수: Discord 개발자 포털에서 발급받은 봇 토큰
DISCORD_TOKEN=

# 선택: 테스트 서버 ID. 설정하면 슬래시 명령어가 그 서버에 즉시 등록됩니다.
# (비워두면 전역 등록 — 반영까지 최대 1시간 걸릴 수 있음)
GUILD_ID=

# 선택: "신곡" 판정 버전 (쉼표로 구분). 곡 데이터의 displayVersion 값과 일치해야 합니다.
# 새 버전이 나오면 여기만 바꾸면 됩니다.
MAIMAI_NEW_VERSIONS=maimaiでらっくす CiRCLE
CHUNITHM_NEW_VERSIONS=CHUNITHM X-VERSE-X

# 선택: 곡 제목용 일본어 폰트 경로 (자동 탐색이 실패할 때만)
FONT_PATH=

# 권장: SEGA 로그인 토큰 암호화 키. 아래 명령으로 생성하세요.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 비워두면 토큰이 평문으로 저장됩니다. 키를 바꾸면 모두 다시 로그인해야 합니다.
TOKEN_ENCRYPTION_KEY=

# 선택
SONGDB_DIR=data/songdb
JACKET_DIR=data/jackets
DB_PATH=data/chumai.db
