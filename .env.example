# 필수: Discord 개발자 포털에서 발급받은 봇 토큰
DISCORD_TOKEN=

# 선택: 접두어 명령어 (예: !b50 chuni). 비워두면 슬래시 명령어만 씁니다.
# 쓰려면 Discord 개발자 포털 → Bot → "Message Content Intent"를 켜야 합니다.
PREFIX=!

# 선택: 테스트 서버 ID. 설정하면 슬래시 명령어가 그 서버에 즉시 등록됩니다.
# (비워두면 전역 등록 — 반영까지 최대 1시간 걸릴 수 있음)
GUILD_ID=

# 선택: "신곡" 판정 버전 (쉼표로 구분). 곡 데이터의 displayVersion 값과 일치해야 합니다.
# 새 버전이 나오면 여기만 바꾸면 됩니다.
MAIMAI_NEW_VERSIONS=maimaiでらっくす CiRCLE,maimaiでらっくす CiRCLE PLUS
CHUNITHM_NEW_VERSIONS=CHUNITHM X-VERSE-X

# 선택: 곡 제목용 일본어 폰트 경로 (자동 탐색이 실패할 때만)
FONT_PATH=

# 권장: SEGA 로그인 토큰 암호화 키. 아래 명령으로 생성하세요.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 비워두면 토큰이 평문으로 저장됩니다. 키를 바꾸면 모두 다시 로그인해야 합니다.
TOKEN_ENCRYPTION_KEY=

# 선택: 배경 스타일
#   version(기본, 버전 배경 그림) / collage(1위 곡 자켓) / mosaic(자켓 모자이크) / clean / calm / glow / light
B50_STYLE=version

# 선택: 채보 맞히기용 채보 이미지 캐시 폴더
CHART_DIR=data/charts

# 선택: 한글+일본어 글꼴 저장 폴더 (처음 실행 때 Noto Sans CJK 약 17MB를 받아요)
FONT_DIR=data/fonts

# 선택: 메모리가 적은 호스팅(예: 디스호스트 무료 128MB)용. B50은 60%, 상수표·추천은 70% 크기로 그려서
# 메모리를 아껴요 (최대 약 118MB). 상수표는 한 장에 45곡까지.
LOW_MEMORY=0
# 선택: B50 크기 직접 지정 (예: 0.7). 비우면 LOW_MEMORY일 때 0.6, 아닐 때 1
B50_SCALE=

# 선택: 플레이 로그 확인 주기(초). 기본·최소 30
PLAYLOG_INTERVAL_SECONDS=30

# 선택: 플레이 로그를 확인하지 않는 시간(한국 시간, 시작-끝). 기본 22-8, 항상 확인하려면 off
PLAYLOG_QUIET_HOURS=22-8

# 선택: 이미지 형식 (webp 기본, 가장 작음 / jpeg / png)
IMAGE_FORMAT=webp

# 선택: 레이팅 판 스타일 (glass / bare / stripe)
PLATE_STYLE=glass

# 선택: 공식 로고 이미지 주소 (PNG/JPG/WebP). 공식 사이트에서 로고를 우클릭 → "이미지 주소 복사"로 얻을 수 있어요.
# 비워두면 글자로 된 로고를 그립니다. 배경이 투명한 PNG가 가장 보기 좋아요.
MAIMAI_LOGO_URL=
CHUNITHM_LOGO_URL=

# 선택
SONGDB_DIR=data/songdb
JACKET_DIR=data/jackets
LOGO_DIR=data/logos
DB_PATH=data/chumai.db
