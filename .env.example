# 필수: Discord 개발자 포털에서 발급받은 봇 토큰
DISCORD_TOKEN=

# 선택: 테스트 서버 ID. 설정하면 슬래시 명령어가 그 서버에 즉시 등록됩니다.
# (비워두면 전역 등록 — 반영까지 최대 1시간 걸릴 수 있음)
GUILD_ID=

# 선택: "신곡" 판정 버전 (쉼표로 구분). Kamaitachi의 displayVersion 값과 일치해야 합니다.
# 새 버전이 나오면 여기만 바꾸면 됩니다.
MAIMAI_NEW_VERSIONS=maimaiでらっくす CiRCLE
CHUNITHM_NEW_VERSIONS=CHUNITHM X-VERSE-X

# 선택: 한글/일본어가 들어간 폰트 경로 (자동 탐색이 실패할 때만)
FONT_PATH=

# 선택
TACHI_BASE_URL=https://kamai.tachi.ac/api/v1
TACHI_API_KEY=
DB_PATH=data/chumai.db
